lang(381, Exploit_MagicGate_failed_psx, "Ocorreu o erro %d.\nPorque ocorreu uma falha no teste do MagicGate no\ncartao de memoria mc%d:. Instale o OSDMenu no MBR\ndo caminho xfrom:/BIEXEC-SYSTEM/xosdmain.elf\ne, opcionalmente, pode ser utilizado o OSDMenu\n(recomendado). Por favor, consulte a pagina\nhttps://github.com/pcm720/OSDMenu")
lang(382, Exploit_MagicGate_failed_opentuna, "Ocorreu o erro %d.\nPorque ocorreu uma falha no teste do MagicGate no\ncartao de memoria mc%d:. Instale o OpenTuna no %s,\ne tente novamente")
lang(383, Exploit_Info_Line_1, "O Exploit no cartao de memoria com o LoadBOOTer")
lang(384, Exploit_Info_Line_2, "funciona para a VERSAO DA ROM 1.00-2.20,")
lang(385, Exploit_Info_Line_3, "com excecao dos consoles das series DTL-H10000(S)\n(utilize o ProtoPwn), DTL-H3000X e DTL-T1XXXX")
lang(386, Exploit_Info_Line_4, "Este exploit simplesmente inicia o arquivo no\ncartao de memoria mc?:/BOOT/BOOT.ELF, permitindo")
lang(387, Exploit_Info_Line_5, "que voce faca alteracoes livremente, sem a\nnecessidade de uma assinatura de outro exploit,")
lang(388, Exploit_Info_Line_6, "tudo isto gracas ao trabalho voluntario do\nprogramador pcm720")
lang(389, Exploit_Info_Line_7, "E recomendado utilizar como BOOT.ELF:")
